+
+// Reprints the visible rows after the list has scrolled under a stationary
+// cursor. The cursor is re-initialised because it lives in the window's own
+// pixels, and refilling those to clear the old text takes it with them.
+static void StartMenuRedrawItems(void)
+{
+    s8 state = 0;
+
+    FillWindowPixelBuffer(GetStartMenuWindowId(), PIXEL_FILL(1));
+    while (PrintStartMenuItems(&state, 1) == FALSE)
+        ;
+    sStartMenuCursorPos = Menu_InitCursor(GetStartMenuWindowId(), FONT_NORMAL, 0, 0, 15,
+                                          StartMenuVisibleCount(), sStartMenuCursorPos);
+    CopyWindowToVram(GetStartMenuWindowId(), COPYWIN_GFX);
+}
