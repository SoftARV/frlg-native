+// Stepping one of these offsets, which may go backwards.
+//
+// The fields are a u8 and a u16, so they wrap at 256 and at 65536, and taking a
+// modulus afterwards is only the same thing when the modulus divides those. 32
+// and 64 do, which is why this was never wrong before; 80 does not, and a step
+// back from zero landed at 14 rather than 78 -- one metatile column of map, in
+// the wrong place, at the edge of the screen.
+//
+// The deltas arrive as u32 holding small negative numbers, which is how upstream
+// passes them.
+static u32 wrap_step(u32 value, u32 delta, s32 period)
+{
+    s32 stepped = (s32)value + (s32)delta;
+
+    stepped %= period;
+    if (stepped < 0)
+        stepped += period;
+    return (u32)stepped;
+}
