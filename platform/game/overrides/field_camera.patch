+// A 64-tile-wide background is two 32x32 screen blocks side by side, not one
+// 64-wide array: a tile with x below 32 is in the first block, the rest are
+// 0x400 entries further on, and a row is still 32 wide inside each. Writing it
+// as though it were linear scatters every tile between the two, which draws a
+// forest of duplicated columns with the player nowhere in it.
+// The buffer holds 32x16 metatiles where the hardware's screen shows 15x10, and
+// a centred viewport reaches equally far both ways -- so the player belongs in
+// the middle of it rather than at the corner upstream drew from.
+//
+// Column 15 and row 9 are where upstream already puts them inside its own
+// window, so putting them there costs the native view nothing and leaves the
+// extra either side for a wider one. The origin follows: the camera indexes the
+// map buffer with pos.x/pos.y read as virtual coordinates, where the player sits
+// at MAP_OFFSET. Both offsets are therefore relative to MAP_OFFSET, and a change
+// to it (agb/prelude.h) carries them along -- which is what keeps the window
+// inside the map buffer at every position, so that no column falls back to the
+// map's border tile.
+#define VIEW_ORIGIN_X (MAP_OFFSET - 15)
+#define VIEW_ORIGIN_Y (MAP_OFFSET - 9)
+
+// Where the hardware's own 240x160 window sits inside that buffer, in pixels.
+// The vertical carries upstream's own half-metatile with it.
+#define VIEW_SCROLL_X (8 * 16)
+#define VIEW_SCROLL_Y (2 * 16 + 8)
+
+static u32 TilemapOffset(u32 x, u32 y)
+{
+    return (x >= 32 ? 0x400 : 0) + y * 32 + (x & 31);
+}
